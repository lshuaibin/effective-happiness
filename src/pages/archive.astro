---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPosts, formatDate, groupByYear } from '../utils/posts';

const base = import.meta.env.BASE_URL;
const posts = await getPosts();
const yearGroups = groupByYear(posts);
---

<BaseLayout title="归档 · 闲敲棋子">
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-12 flex-1 w-full">
    <h1 class="text-3xl mb-8">归档</h1>
    {yearGroups.length === 0 ? (
      <p class="text-warm-gray text-center py-12 font-sans">暂无文章</p>
    ) : (
      yearGroups.map(([year, yearPosts]) => (
        <section class="mb-8">
          <h2 class="text-2xl text-dark-brown mb-4">{year}</h2>
          <ul class="space-y-2">
            {yearPosts.map((post) => (
              <li class="flex items-baseline gap-3 font-sans text-sm">
                <time class="text-warm-gray/60 shrink-0 w-28">{formatDate(post.data.date)}</time>
                <a
                  href={`${base}posts/${post.id.replace(/\.md$/, '')}/`}
                  class="text-dark-brown hover:text-warm-gold transition-colors no-underline truncate"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )}
  </main>
  <Footer />
</BaseLayout>
