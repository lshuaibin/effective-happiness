---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../utils/posts';

export async function getStaticPaths({ paginate }: any) {
  const posts = await getPosts();
  return paginate(posts, { pageSize: 5 });
}

const { page } = Astro.props;
---

<BaseLayout title="闲敲棋子 · Personal Blog">
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-12 flex-1 w-full">
    <section class="mb-10">
      <p class="text-warm-gray font-sans text-lg">
        落子无悔，闲敲棋子落灯花。
      </p>
    </section>
    <PostList posts={page.data} />
    <nav class="flex justify-between items-center mt-10 pt-6 border-t border-light-tan font-sans text-sm">
      {page.url.prev ? (
        <a href={page.url.prev} class="text-warm-gray hover:text-dark-brown transition-colors no-underline">
          ← 上一页
        </a>
      ) : <span />}
      <span class="text-warm-gray/60">第 {page.currentPage} / {page.lastPage} 页</span>
      {page.url.next ? (
        <a href={page.url.next} class="text-warm-gray hover:text-dark-brown transition-colors no-underline">
          下一页 →
        </a>
      ) : <span />}
    </nav>
  </main>
  <Footer />
</BaseLayout>
